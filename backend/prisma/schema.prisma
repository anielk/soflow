generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Roles ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  USER
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  username            String            @unique
  passwordHash        String
  name                String?
  bio                 String?
  avatarUrl           String?
  bannerUrl           String?
  isCreator           Boolean           @default(false)
  role                Role              @default(USER)
  // Password reset — resetTokenHash stores sha256(rawToken), never the raw
  // token itself, so a database read alone can't be used to reset a password.
  resetTokenHash      String?           @unique
  resetTokenExpiresAt DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  // Which of this user's WorkspaceMember rows is "current" — see
  // WorkspaceService.resolveMembership for the resolution + fallback logic.
  // SetNull (not Cascade) so deleting a workspace never cascades into
  // deleting the user themselves; resolveMembership falls back to their
  // oldest remaining membership when this is null or stale.
  activeWorkspaceId   String?
  activeWorkspace     Workspace?        @relation("UserActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)
  creatorProfile      CreatorProfile?
  workspaceMembers    WorkspaceMember[]
  media               Media[]
  posts               Post[]

  @@index([activeWorkspaceId])
}

model CreatorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String?
  bio         String?
  avatarUrl   String?
  bannerUrl   String?
  website     String?
  socialLinks Json?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model HealthSnapshot {
  id        String   @id @default(cuid())
  status    String
  createdAt DateTime @default(now())
}

// ─── Multi-tenancy foundation ─────────────────────────────────────────────────
// Workspaces are the top-level unit of tenancy.
// Nothing currently enforces a single workspace — the architecture is open.

model Workspace {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  plan            String            @default("free")
  // Per-workspace override of the plan's default upload cap (see
  // PLAN_UPLOAD_LIMITS_MB in backend/src/media/upload-limits.ts). Null means
  // "use the plan default" — this only needs a value for a negotiated
  // Enterprise limit that differs from the plan default.
  maxUploadSizeMb Int?
  isActive        Boolean           @default(true)
  // Branding — logo only for now; accent color and favicon are deliberately
  // not modeled yet (still "(future)" per the sprint that added this).
  logoUrl         String?
  // Localization structure only — no i18n/translation framework, no locale
  // beyond the default is actually implemented yet. These fields exist so
  // Settings has somewhere real to persist a choice when that work lands.
  locale          String            @default("en")
  timezone        String            @default("UTC")
  dateFormat      String            @default("MM/DD/YYYY")
  numberFormat    String            @default("en-US")
  currency        String            @default("USD")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  members         WorkspaceMember[]
  aiConnections   AIConnection[]
  media           Media[]
  creators        Creator[]
  posts           Post[]
  // Back-relation required by Prisma for User.activeWorkspace — not queried
  // directly anywhere (a workspace doesn't need to know who has it active).
  activeForUsers  User[]            @relation("UserActiveWorkspace")
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        Role      @default(USER)
  joinedAt    DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

// ─── AI provider architecture ──────────────────────────────────────────────────
// Providers and models are stored in the database, not hardcoded.
// Each workspace connects to providers via AIConnection.
// This allows dynamic provider registration without code changes.

model AIProvider {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique // e.g. "openai", "anthropic", "ollama"
  baseUrl     String? // required for self-hosted (Ollama, Azure)
  authType    String // "api_key" | "none" | "bearer" | "azure"
  isEnabled   Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  models      AIModel[]
  connections AIConnection[]
}

model AIModel {
  id              String     @id @default(cuid())
  providerId      String
  name            String // display name: "GPT-4o"
  modelId         String // API value: "gpt-4o"
  contextWindow   Int? // max tokens
  inputCostPer1k  Float? // USD per 1k input tokens
  outputCostPer1k Float? // USD per 1k output tokens
  capabilities    String[] // ["chat","vision","code","embedding"]
  isEnabled       Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  provider        AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, modelId])
}

model AIConnection {
  id           String     @id @default(cuid())
  workspaceId  String
  providerId   String
  encryptedKey String? // AES-encrypted API key
  baseUrl      String? // workspace-level override
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider     AIProvider @relation(fields: [providerId], references: [id])

  @@unique([workspaceId, providerId])
}

model AISettings {
  id                String   @id @default(cuid())
  workspaceId       String?  @unique // null = platform-global default
  defaultProviderId String?
  defaultModelId    String?
  temperature       Float    @default(0.7)
  maxTokens         Int      @default(2048)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ─── Media Library ──────────────────────────────────────────────────────────
// Media metadata lives in Postgres; the actual bytes live on a pluggable
// storage backend (see StorageService). storageProvider identifies which
// backend a given file lives on, so providers can be swapped/mixed without
// a data migration.

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

model Media {
  id               String      @id @default(cuid())
  workspaceId      String
  ownerId          String
  creatorId        String? // optional: which agency-managed Creator this belongs to (null = general workspace media)
  filename         String // generated safe on-disk name
  originalFilename String // user-supplied name, display only, never trusted
  mimeType         String
  extension        String
  sizeBytes        BigInt // BigInt: default 2GB max overflows Int32
  width            Int?
  height           Int?
  duration         Float?
  type             MediaType
  status           MediaStatus @default(PROCESSING)
  storageProvider  String // "local" today; matches StorageService driver id
  storagePath      String // key within that provider
  thumbnailPath    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner            User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // SetNull rather than Cascade: deleting a creator must not silently delete
  // their uploaded files — media just becomes unassigned, still visible in
  // the workspace's general library.
  creator          Creator?    @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  // Optional: which Post (if any) this file is attached to. SetNull, not
  // Cascade — deleting a post must not delete the underlying media, since
  // the same upload could conceivably be reused and the file itself still
  // belongs to the workspace's library either way.
  postId           String?
  post             Post?       @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([creatorId])
  @@index([postId])
}

// ─── Posts (content composer / publishing queue) ─────────────────────────────
// Deliberately narrow scope: this models the *content and its schedule*, not
// distribution. There is no integration with any external platform (OnlyFans,
// Fanvue, ...) — see Settings > Platforms, which is honest about that — so a
// Post only ever reaches DRAFT or SCHEDULED here. Nothing "publishes" itself;
// there is no background job that flips a SCHEDULED post to a PUBLISHED
// state, because there is nowhere for it to actually go yet. Adding a real
// PUBLISHED state belongs together with the first real platform integration,
// not before it.

enum PostType {
  FREE
  PPV
}

enum PostStatus {
  DRAFT
  SCHEDULED
}

model Post {
  id          String     @id @default(cuid())
  workspaceId String
  authorId    String
  caption     String?    @db.Text
  type        PostType   @default(FREE)
  // Informational only (no payment processing exists) — mirrors how Workspace.plan
  // is stored as plain data with no enforcement engine behind it yet.
  price       Int?
  status      PostStatus @default(DRAFT)
  scheduledAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media       Media[]

  @@index([workspaceId])
  @@index([authorId])
  @@index([status])
}

// ─── Creators (agency-managed roster) ────────────────────────────────────────
// A Creator is a person the agency manages content/analytics for — distinct
// from a User (a Leinaflow login/teammate). Creators don't need their own
// account here; workspace members manage them.

enum CreatorStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model Creator {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  email       String?
  phone       String?
  bio         String?
  notes       String?       @db.Text
  tags        String[]      @default([])
  avatarUrl   String?
  status      CreatorStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  media       Media[]

  @@index([workspaceId])
}

// ─── Observability & audit foundation ────────────────────────────────────────
// AuditLog/ActivityLog deliberately have NO Prisma @relation to User/Workspace.
// An audit trail must outlive the entities it describes — if a user or
// workspace is later deleted, its history must not cascade away or dangle a
// broken foreign key. workspaceId/userId are plain, unvalidated references;
// look up the live record separately if it still exists.

enum AuditCategory {
  AUTH
  WORKSPACE
  MEDIA
  CREATOR
  USER
  NOTIFICATION
  SETTINGS
  SECURITY
  SYSTEM
  CONTENT
}

// Structured, append-only trail for administrators and the Cloudivo
// Operations Center (COC). Never updated or
// deleted by the application — see AuditService for the write path (it's the
// only writer) and audit.controller.ts for the read-only query surface.
model AuditLog {
  id          String        @id @default(cuid())
  workspaceId String?
  userId      String?
  eventType   String
  category    AuditCategory
  targetType  String?
  targetId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime      @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@index([category])
  @@index([eventType])
  @@index([createdAt])
}

// Human-readable, workspace-facing trail ("John uploaded a video"). Separate
// from AuditLog on purpose: activity is for people, audit is for admins —
// activity omits security-sensitive events (failed logins, etc.) and stores
// a denormalized actorName so entries stay readable even if the user is
// later removed from the workspace.
model ActivityLog {
  id          String        @id @default(cuid())
  workspaceId String?
  userId      String?
  actorName   String?
  message     String
  category    AuditCategory
  targetType  String?
  targetId    String?
  createdAt   DateTime      @default(now())

  @@index([workspaceId])
  @@index([createdAt])
}
