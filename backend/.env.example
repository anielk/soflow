NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://creator_admin:creator_password@localhost:5432/creator_platform?schema=public
REDIS_URL=redis://localhost:6379

# Media storage — "local" is the only implemented driver today; the app is
# structured so minio/s3/azure/gcs can be added as new StorageProvider
# implementations without touching call sites.
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_PATH=/data/media
# Hard technical ceiling only (DoS/disk backstop) — the real per-plan upload
# cap is Free 100MB / Pro 500MB / Enterprise 2048MB (configurable per
# workspace), enforced in MediaService. Keep this >= the largest of those.
MEDIA_MAX_FILE_SIZE_MB=2048

FRONTEND_URL=http://localhost:3000

# Notifications — "smtp" is the only implemented driver today; the app is
# structured so teams/slack/discord/push/sms/coc can be added as new
# NotificationProvider implementations without touching call sites. Point
# SMTP_HOST at a local catcher (e.g. mailhog on port 1025) for dev.
NOTIFICATION_DRIVER=smtp
NOTIFICATION_TEAM_EMAIL=hello@leinaflow.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Leinaflow
SMTP_FROM_EMAIL=noreply@leinaflow.com
SMTP_REPLY_TO=
