# Prefix for every Docker resource name (containers, network, volumes) —
# see docs/deployment/Architecture.md#multi-product-naming. Change this
# per product when reusing this deployment standard elsewhere (e.g.
# "ticketengine", "identity") so multiple Cloudivo products can safely
# share a Docker host without name collisions.
PROJECT_NAME=creator
FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379

POSTGRES_DB=creator_platform
POSTGRES_USER=creator_admin
POSTGRES_PASSWORD=replace_with_secure_password
DATABASE_URL=postgresql://creator_admin:replace_with_secure_password@postgres:5432/creator_platform?schema=public

REDIS_URL=redis://redis:6379

# Relative path, not an absolute host: NPM/the reverse proxy forwards to the
# frontend on port 80, and frontend/next.config.mjs's `/v1/:path*` rewrite
# proxies same-origin requests to the backend container internally (see
# docs/deployment/Architecture.md). The backend is never published on a
# public host/port, so an absolute URL here (e.g. https://api.example.com)
# can't ever resolve from the browser.
NEXT_PUBLIC_API_URL=/v1
BACKEND_PROXY_URL=http://backend:4000
NODE_ENV=production

# Left blank on purpose — deployment/install.sh generates a random value for
# these if empty when it creates .env/.env.production from this template.
# Generate one yourself with: openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=

MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_PATH=/data/media
MEDIA_MAX_FILE_SIZE_MB=2048

# Used to build links inside emails (reset links, invite links, ...) — must
# be the public URL your users load the frontend from.
FRONTEND_URL=https://app.example.com

# Notifications — "smtp" is the only implemented channel today, and it's
# opt-in: SMTP_HOST is left blank on purpose (unlike the placeholder-style
# defaults above) — a fresh install with no mail relay configured yet runs
# with notifications disabled rather than failing health checks or blocking
# deploys. Point SMTP_HOST at your real mail relay (e.g. smtp.cloudivo.com),
# or set NOTIFICATION_DRIVER=disabled explicitly, either way no code changes
# are needed.
#
# Every line below this point may be safely left blank/deleted if this file
# gets trimmed down manually — env.validation.ts's `.empty('')` on these
# fields means a blank value degrades to the same default as an absent one,
# it does not crash the backend at boot (NOTIFICATION_TEAM_EMAIL/SMTP_PORT/
# SMTP_SECURE/SMTP_FROM_NAME/SMTP_FROM_EMAIL). FRONTEND_URL above is the one
# exception — it's genuinely required in production and has no safe default.
NOTIFICATION_DRIVER=smtp
NOTIFICATION_TEAM_EMAIL=hello@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Leinaflow
SMTP_FROM_EMAIL=noreply@example.com
SMTP_REPLY_TO=

# `npm run prisma:seed` (backend/prisma/seed.ts) reads these only if you run
# the seed against this environment to bootstrap the very first SUPER_ADMIN
# on a fresh install — it never touches an account that already exists. It
# is NOT how you rotate an existing SUPER_ADMIN's password; do that via a
# direct, deliberate operational action against the live database instead,
# then leave these blank again.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_USERNAME=

# Dedicated brute-force throttle for POST /auth/login — separate from and
# stricter than RATE_LIMIT_MAX above. See backend/src/auth/login-throttle.guard.ts.
LOGIN_RATE_LIMIT_TTL_MS=60000
LOGIN_RATE_LIMIT_MAX=10
