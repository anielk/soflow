# Development environment variables — template for `.env.development`.
# Copied to `.env.development` by deployment/install.sh (via ensure_env_files)
# when that file doesn't already exist yet; never overwritten afterward.
#
# This is the ONLY file Docker Compose reads for variable interpolation
# (`${VAR}`) when targeting compose.dev.yml — see docs/deployment/Architecture.md.
# Demo/production use the separate `.env.production` file/template instead;
# nothing here is ever read by a demo/production build or deploy.

# Prefix for every Docker resource name (containers, network, volumes) — see
# docs/deployment/Architecture.md#multi-product-naming. Change this per
# product when reusing this deployment standard elsewhere (e.g.
# "ticketengine", "identity") so multiple Cloudivo products can safely share
# a Docker host without name collisions.
PROJECT_NAME=creator

# App ports — published directly to the host in development only (demo/
# production publish a single fixed port 80 for the frontend; the backend
# is never published — see compose.demo.yml/compose.prod.yml).
FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Database
POSTGRES_DB=creator_platform
POSTGRES_USER=creator_admin
POSTGRES_PASSWORD=creator_password
DATABASE_URL=postgresql://creator_admin:creator_password@postgres:5432/creator_platform?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Frontend — a relative path, not an absolute host: proxied to the backend
# container by frontend/next.config.mjs's `/v1/:path*` rewrite (see
# compose.dev.yml's BACKEND_PROXY_URL). This var isn't actually referenced
# via `${...}` in compose.dev.yml (it's hardcoded there directly), but is
# kept here for anyone running `next dev`/`next build` locally without Docker.
NEXT_PUBLIC_API_URL=/v1

# Backend
NODE_ENV=development

# Media storage
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_PATH=/data/media
# Hard technical ceiling only (DoS/disk backstop) — the real per-plan upload
# cap is Free 100MB / Pro 500MB / Enterprise 2048MB (configurable per
# workspace), enforced in MediaService. Keep this >= the largest of those.
MEDIA_MAX_FILE_SIZE_MB=2048

# Used to build links inside emails (reset links, invite links, ...)
FRONTEND_URL=http://localhost:3000

# Left blank on purpose — deployment/install.sh generates a random value for
# these if empty when it creates .env.development from this template.
# Generate one yourself with: openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=

# `npm run prisma:seed` (backend/prisma/seed.ts) reads these to create the
# platform's SUPER_ADMIN account — there is no hardcoded fallback password
# in the seed script itself, on purpose (a prior hardcoded credential here
# was committed to source control and had to be treated as compromised).
# Pick your own values; the seed fails loudly if these are unset.
SEED_SUPER_ADMIN_EMAIL=superadmin@example.local
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_USERNAME=superadmin

# Optional second, unprivileged account for exercising the app without the
# SUPER_ADMIN. Leave both blank to skip seeding it entirely.
SEED_DEV_USER_EMAIL=
SEED_DEV_USER_PASSWORD=
SEED_DEV_USER_USERNAME=

# Dedicated brute-force throttle for POST /auth/login (separate from and
# stricter than RATE_LIMIT_MAX above) — see backend/src/auth/login-throttle.guard.ts.
LOGIN_RATE_LIMIT_TTL_MS=60000
LOGIN_RATE_LIMIT_MAX=10

# Notifications — "smtp" is the only implemented driver today. In dev this
# points at the mailhog container (a local SMTP catcher, not a real relay);
# demo/production point SMTP_HOST at the real Cloudivo mail service instead.
NOTIFICATION_DRIVER=smtp
NOTIFICATION_TEAM_EMAIL=hello@leinaflow.com
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Leinaflow
SMTP_FROM_EMAIL=noreply@leinaflow.com
SMTP_REPLY_TO=
