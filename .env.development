# Global project variables (development defaults)
# Prefix for every Docker resource name (containers, network, volumes) —
# see docs/deployment/Architecture.md#multi-product-naming. Kept as
# "creator" here to match this host's existing containers/volumes
# byte-for-byte; a new product adopting this deployment standard sets its
# own value (e.g. "ticketengine") instead.
PROJECT_NAME=creator

# App ports
FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Database
POSTGRES_DB=creator_platform
POSTGRES_USER=creator_admin
POSTGRES_PASSWORD=creator_password
DATABASE_URL=postgresql://creator_admin:creator_password@postgres:5432/creator_platform?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Frontend — relative path, proxied to the backend container by
# frontend/next.config.mjs's rewrite (see compose.dev.yml's BACKEND_PROXY_URL).
NEXT_PUBLIC_API_URL=/v1

# Backend
NODE_ENV=development

# Required by backend/src/config/env.validation.ts (Joi .required()). Used
# to come from .env.production's env_file: in compose.yml regardless of
# environment (a pre-existing quirk removed when env_file: became
# per-overlay — see docs/deployment/Architecture.md) — now set here directly.
JWT_SECRET=6448fc3ac4e2098dc584811c6efb7b274ff7c60e636d84547e67921120d2757f
SESSION_SECRET=8aefcb4fd5c7da61afa8ec43ec084c635e423a7f562d3a507b4c404fb23c66e1

# Media storage
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_PATH=/data/media
# Hard technical ceiling only (DoS/disk backstop) — the real per-plan upload
# cap is Free 100MB / Pro 500MB / Enterprise 2048MB (configurable per
# workspace), enforced in MediaService. Keep this >= the largest of those.
MEDIA_MAX_FILE_SIZE_MB=2048

# Used to build links inside emails (reset links, invite links, ...)
FRONTEND_URL=http://localhost:3000

# Notifications — "smtp" is the only implemented driver today. In dev this
# points at the mailhog container (a local SMTP catcher, not a real relay);
# production points SMTP_HOST at the real Cloudivo mail service instead.
NOTIFICATION_DRIVER=smtp
NOTIFICATION_TEAM_EMAIL=hello@leinaflow.com
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Leinaflow
SMTP_FROM_EMAIL=noreply@leinaflow.com
SMTP_REPLY_TO=
